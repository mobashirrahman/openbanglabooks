# Copy to .env.local for development. For local Supabase, run `pnpm db:start`
# and copy the values from `pnpm exec supabase status`.

# Public origin used for canonical URLs, sitemap and Open Graph.
# Production: https://openbanglabooks.com (configurable – not a claim of registration)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by ingestion scripts and admin actions. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
