# Copy to .env.local for development. For local Supabase, run `pnpm db:start`
# and copy the values from `pnpm exec supabase status`.

# Public origin used for canonical URLs, sitemap and Open Graph.
# Production: https://openbanglabooks.com (configurable – not a claim of registration)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by ingestion scripts and tests, not by the web server. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Shared secret for POST /api/revalidate (ingestion and admin edits)
REVALIDATE_SECRET=

# Dev only: extra hostnames that may load dev assets, comma-separated (e.g. your Tailscale IP)
DEV_ORIGINS=

# Connections (Hardcover, Readwise). Server-only. CONNECTIONS_KEY seals the
# readers' tokens before they are stored: 32 random bytes, base64
# (openssl rand -base64 32). Losing or changing it disconnects everyone.
CONNECTIONS_KEY=
# A Hardcover OAuth application (confidential client). Register the redirect
# URI <site>/api/connections/hardcover/callback with it.
HARDCOVER_CLIENT_ID=
HARDCOVER_CLIENT_SECRET=
# Only if the redirect URI differs from the site's own origin (e.g. behind a proxy)
HARDCOVER_REDIRECT_URI=
